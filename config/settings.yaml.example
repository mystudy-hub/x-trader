# ==============================================================================
# QH-Trader 统一运行与策略配置模板 (settings.yaml.example)
# 复制为 settings.yaml 并配置本地参数，注意：settings.yaml 已被 .gitignore 忽略，切勿提交！
# 严格遵守规范：未声明策略类别的配置禁止进入模拟盘或实盘 (FR-SCOPE-02)
# ==============================================================================

system:
  # 运行模式: backtest (事件回测) | vector_scan (向量化扫描) | paper (模拟盘) | shadow (影子实盘) | live (真实实盘)
  mode: "backtest"
  environment_id: "dev-windows-01"
  log_level: "INFO"
  log_dir: "runs/logs"

strategy:
  # 策略唯一标识
  name: "dual_thrust_trend"
  version: "0.1.0"
  
  # 策略类别声明 (必须显式声明，用于风控与执行模式适配: trend_following / mean_reversion / arbitrage / hft)
  category: "trend_following"
  
  # 信号频率 (bar_daily / bar_hourly / bar_minute / tick)
  signal_frequency: "bar_hourly"
  
  # 执行策略: NEXT_OPEN (次根Bar开盘价) | THIS_CLOSE (当根Bar收盘价) | TWAP | VWAP
  execution_strategy: "NEXT_OPEN"
  
  # 价格数据粒度 (1d / 1h / 1m / tick)
  data_granularity: "1h"
  
  # 目标合约池 (首版首个工程样本: 上期所螺纹钢 SHFE.rb)
  symbols:
    - "SHFE.rb"

risk:
  # 硬风控约束参数
  account_id: "sim_account_01"
  initial_capital: 1000000.0        # 初始资金
  max_order_size: 10                # 单笔最大报单手数
  max_position_per_symbol: 50       # 单品种最大持仓手数
  max_order_cancellations_day: 400  # 日内报撤单次数上限 (防过度撤单与对倒嫌疑)
  circuit_breaker_loss_pct: 0.05    # 日内回撤熔断阈值 (5%)

data:
  # 存储与历史数据路径
  storage_dir: "data_storage"
  parquet_compression: "ZSTD"
  use_memory_cache: true

storage:
  # 事务日志与元数据
  journal_db_path: "live/trading.db"
  rules_db_path: "config/rule_sources/rules.db"

# 柜台连接信息 (仅在 paper / shadow / live 模式生效)
# 生产环境中凭证应通过环境变量注入 (如 CTP_PASSWORD, CTP_AUTHCODE)
broker:
  profile: "openctp_sim"            # 对应 config/broker_profiles/ 中的配置
  front_trade_uri: "tcp://180.168.146.187:10130"
  front_market_uri: "tcp://180.168.146.187:10131"
  broker_id: "9999"
  investor_id: "your_investor_id"
  app_id: "simnow_client_test"
  # 注意: 绝不在 example 中保留真实密码或 AuthCode

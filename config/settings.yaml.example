# QH-Trader 配置模板；复制为 config/settings.yaml 后按 S0 清单填写。
# 路径均相对于仓库根目录。示例金额和风控参数供工程开发使用，须在运行配置中确认。

system:
  # backtest / vector_scan / paper / shadow / live / replay
  mode: "backtest"
  environment_id: "dev-windows-01"
  log_level: "INFO"
  log_dir: "runs/logs"

accounting:
  # research: 显式记录研究假设；exact: 缺关键数据或规则时中止。
  mode: "research"

strategy:
  name: "dual_thrust_trend"
  version: "0.1.0"
  # FR-SCOPE-02/03 的能力类别：low_frequency_cta / minute_intraday / tick。
  category: "low_frequency_cta"
  style: "trend_following"
  # bar_daily / bar_hourly / bar_minute / tick
  signal_frequency: "bar_hourly"
  # FR-EXEC-02；均须满足信号已可见、订单已生效及所需执行价格存在。
  # NEXT_SESSION_OPEN: 下一可交易时段开盘。
  # NEXT_DAY_SESSION_OPEN: 下一日盘开盘。
  # NEXT_DAY_FIXED_TIME: 下一日盘收盘前固定时间。
  # NEXT_BAR_OPEN: 下一可用 Bar 开盘。
  execution_strategy: "NEXT_BAR_OPEN"
  fixed_time_before_close_minutes: null  # 使用 NEXT_DAY_FIXED_TIME 时填写正数。
  missed_execution: "defer"              # defer: 顺延；cancel: 取消本次信号。
  # 信号频率不替代执行价格覆盖核验：1d / 1h / 1m / tick。
  data_granularity: "1h"
  symbols:
    - "SHFE.rb"                         # 策略使用品种标识，成交映射到实际合约。

risk:
  account_id: "sim_account_01"
  initial_capital: "1000000.00"          # 虚拟工程样例资金，金额用十进制字符串。
  max_order_size: 10
  max_position_per_symbol: 50
  max_order_cancellations_day: null       # 核验账户规则、计数事件和窗口后配置。
  circuit_breaker_loss_pct: "0.05"       # 示例阈值，回撤基准及现金流调整须明确。
  drawdown_basis: null
  allow_lock: null                       # D-10：S2 前按账户能力确定。

data:
  storage_dir: "data_storage"
  parquet_compression: "ZSTD"
  use_memory_cache: true
  engineering_sample:
    contract: "SHFE.rb2410"
    start_date: null                     # 样本期间、授权和数据覆盖在 S0 确认。
    end_date: null

storage:
  journal_db_path: "data_storage/live/trading.db"
  rules_db_path: "data_storage/meta/control.db"

# 柜台接入信息由 S0 核验后填写；密码与 AuthCode 通过本地秘密配置或环境变量加载。
# null 表示待核验，不能用占位值连接柜台。
broker:
  profile: null                         # 对应 config/broker_profiles/ 中的已核验配置。
  front_trade_uri: null
  front_market_uri: null
  broker_id: null
  investor_id: null
  app_id: null
